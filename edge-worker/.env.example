# Laravel API (Sanctum token from php artisan db:seed --class=EdgeWorkerTokenSeeder)
LARAVEL_API_BASE_URL=http://localhost:8000/api/v1
LARAVEL_API_TOKEN=

# Groq (ultra-low-latency ANPR OCR fallback)
GROQ_API_KEY=
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# This worker's target camera (must match cctv_cameras.code in Laravel).
# rtsp_url is NOT set here -- it's fetched from Laravel's
# GET /cctv-cameras/{code} at startup, decrypted server-side, along with
# zone_type and the lane geofence.
CAMERA_CODE=CCTV-JKT-SDN-014

# Detection tuning
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
VEHICLE_CLASSES=car,motorcycle,bus,truck
STATIONARY_MOVEMENT_TOLERANCE_PX=18
STATIONARY_THRESHOLD_SECONDS=180
FRAME_SAMPLE_INTERVAL_SECONDS=1.0

# Busway lane geofence, as "lng1,lat1;lng2,lat2;..." polygon in image-plane-mapped
# geographic coordinates (pulled from Laravel's cctv_cameras.lane_geofence at
# startup in production; this is the local-dev fallback).
LANE_GEOFENCE_OVERRIDE=
